# sentence_id = 119
# translation_lang = en
# prose_translation = Socrates: But I for my part, Crito, want to examine this question together with you — whether it will appear any different to me, once I'm in this state, or whether it will seem the same — and whether we shall dismiss it or go along with it.
# literal_translation = Socrates: But I-indeed want, O Crito, to examine [it] in-common with you, whether [it] will-appear anything different to-me, since I-am-disposed thus, or the same [one], and whether we-will-let [it] go, or we-will-be-persuaded by-it.

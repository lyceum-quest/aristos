{
  "experiment_version": 2,
  "provider": {
    "name": "ppq",
    "base_url": "https://api.ppq.ai/v1",
    "api_key_env": "PPQ_API_KEY"
  },
  "model": {
    "id": "deepseek/deepseek-v4-flash-0731"
  },
  "generation": {
    "temperature": 1,
    "top_p": 1,
    "seed": 1,
    "reasoning": {
      "enabled": false,
      "exclude": true
    },
    "include_reasoning": false,
    "provider": {
      "only": [
        "OpenInference"
      ],
      "require_parameters": true,
      "allow_fallbacks": false
    },
    "max_tokens": 4096,
    "frequency_penalty": 0,
    "presence_penalty": 0,
    "response_format": {
      "type": "json_schema",
      "json_schema": {
        "name": "contextual_glosses",
        "strict": true,
        "schema": {
          "type": "object",
          "properties": {
            "glossed_text": {
              "type": "string"
            }
          },
          "required": [
            "glossed_text"
          ],
          "additionalProperties": false
        }
      }
    }
  }
}

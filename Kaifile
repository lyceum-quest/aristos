# Every deepseek-jev task below makes paid API calls and requires the
# config-specific DEEPSEEK_JEV_AUTHORIZE=run:<sha256> printed by its check.
task run-deepseek-jev {
  environment: "dev"
  run: ["roc", "experiments/deepseek-jev/run.roc", "--run"]
}

task resume-deepseek-jev {
  environment: "dev"
  run: ["roc", "experiments/deepseek-jev/run.roc", "--resume"]
}

task check-browser-boundary {
  environment: "dev"
  run: ["roc", "scripts/check-browser-boundary.roc"]
}

task build {
  environment: "dev"
  run: ["elm", "make", "src/Main.elm", "--output=elm.js"]
}

task serve {
  environment: "dev"
  run: [
    "elm-live",
    "src/Main.elm",
    "--dir=.",
    "--host=localhost",
    "--port=8000",
    "--hot",
    "--",
    "--output=elm.js"
  ]
}

task bundle {
  environment: "dev"
  run: ["roc", "scripts/build-release.roc"]
}

task publish {
  environment: "dev"
  run: ["roc", "scripts/deploy.roc"]
}

task provision {
  environment: "dev"
  run: ["roc", "scripts/deploy.roc", "infrastructure"]
}

workflow dev {
  steps: [
    "run preload",
    "run check-browser-boundary",
    "run build",
    "run serve"
  ]
}

workflow release {
  steps: [
    "run check-preload-tool",
    "run check-release-tool",
    "run check-browser-boundary-tool",
    "run check-deploy-tool",
    "run check-lint-tool",
    "run check-model-experiment-tool",
    "run check-conllu-experiment-tool",
    "run check-oga-conllu-exp2-tool",
    "run check-jev-gloss-experiment-tool",
    "run check-jev-gloss-experiment-4-tool",
    "run check-jev-gloss-evaluation-4-tool",
    "run check-deepseek-jev-tool",
    "run check-deepseek-jev",
    "run preload",
    "run check-deepseek-v4-flash-0731-experiment",
    "run check-deepseek-v4-flash-0731-experiment-3",
    "run check-deepseek-v4-flash-0731-experiment-4",
    "run construct-deepseek-v4-flash-0731-experiment-4",
    "run worksheet-deepseek-v4-flash-0731-experiment-4",
    "run evaluate-example-deepseek-v4-flash-0731-experiment-4",
    "run check-qwen35-experiment",
    "run check-qwen35-397b-experiment",
    "run check-claude-sonnet-46-experiment",
    "run check-gpt53-codex-experiment",
    "run check-qwen38-experiment",
    "run check-mistral-small4-experiment",
    "run check-conllu-deepseek-v4-flash-0731-experiment",
    "run check-conllu-deepseek-v4-pro-0813-experiment",
    "run check-conllu-glm53-experiment",
    "run check-conllu-claude-sonnet-46-experiment",
    "run check-conllu-gpt53-codex-experiment",
    "run check-browser-boundary",
    "run bundle"
  ]
}

workflow deploy {
  steps: [
    "run preload",
    "run check-browser-boundary",
    "run bundle",
    "run publish"
  ]
}

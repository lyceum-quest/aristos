environment dev {
  packages: [
    "bashInteractive",
    "coreutils",
    "curl",
    "elmPackages.elm",
    "elmPackages.elm-live",
    "git",
    "gnugrep",
    "openssh",
    "roc",
    "rsync"
  ]
}

task preload {
  environment: "dev"
  run: [
    "roc",
    "scripts/build-corpus-preload.roc",
    "preload",
    "anabasis",
    "conllu/xenophon/anabasis/book-01-first-sentence.tb.conllu"
  ]
}

task lint {
  environment: "dev"
  run: ["roc", "scripts/lint.roc"]
}

task check-deepseek-experiment {
  environment: "dev"
  run: ["roc", "scripts/run-model-experiment.roc", "deepseek", "--check"]
}

task deepseek-experiment {
  environment: "dev"
  run: ["roc", "scripts/run-model-experiment.roc", "deepseek"]
}

task check-qwen35-experiment {
  environment: "dev"
  run: ["roc", "scripts/run-model-experiment.roc", "qwen3.5-9b", "--check"]
}

task qwen35-experiment {
  environment: "dev"
  run: ["roc", "scripts/run-model-experiment.roc", "qwen3.5-9b"]
}

task check-qwen35-397b-experiment {
  environment: "dev"
  run: ["roc", "scripts/run-model-experiment.roc", "qwen3.5-397b-a17b", "--check"]
}

task qwen35-397b-experiment {
  environment: "dev"
  run: ["roc", "scripts/run-model-experiment.roc", "qwen3.5-397b-a17b"]
}

task check-claude-sonnet-46-experiment {
  environment: "dev"
  run: ["roc", "scripts/run-model-experiment.roc", "claude-sonnet-4.6", "--check"]
}

task claude-sonnet-46-experiment {
  environment: "dev"
  run: ["roc", "scripts/run-model-experiment.roc", "claude-sonnet-4.6"]
}

task check-gpt53-codex-experiment {
  environment: "dev"
  run: ["roc", "scripts/run-model-experiment.roc", "gpt-5.3-codex", "--check"]
}

task gpt53-codex-experiment {
  environment: "dev"
  run: ["roc", "scripts/run-model-experiment.roc", "gpt-5.3-codex"]
}

task check-browser-boundary {
  environment: "dev"
  run: ["roc", "scripts/check-browser-boundary.roc"]
}

task build {
  environment: "dev"
  run: ["elm", "make", "src/Main.elm", "--output=elm.js"]
}

task serve {
  environment: "dev"
  run: [
    "elm-live",
    "src/Main.elm",
    "--dir=.",
    "--host=localhost",
    "--port=8000",
    "--hot",
    "--",
    "--output=elm.js"
  ]
}

task bundle {
  environment: "dev"
  run: ["roc", "scripts/build-release.roc"]
}

task publish {
  environment: "dev"
  run: ["roc", "scripts/deploy.roc"]
}

task provision {
  environment: "dev"
  run: ["roc", "scripts/deploy.roc", "infrastructure"]
}

workflow dev {
  steps: [
    "run preload",
    "run check-browser-boundary",
    "run build",
    "run serve"
  ]
}

workflow release {
  steps: [
    "run preload",
    "run check-deepseek-experiment",
    "run check-qwen35-experiment",
    "run check-qwen35-397b-experiment",
    "run check-claude-sonnet-46-experiment",
    "run check-gpt53-codex-experiment",
    "run check-browser-boundary",
    "run bundle"
  ]
}

workflow deploy {
  steps: [
    "run preload",
    "run check-browser-boundary",
    "run bundle",
    "run publish"
  ]
}

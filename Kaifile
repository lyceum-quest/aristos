environment dev {
  packages: [
    "bashInteractive",
    "coreutils",
    "curl",
    "elmPackages.elm",
    "elmPackages.elm-live",
    "elmPackages.elm-test",
    "git",
    "gnugrep",
    "openssh",
    "rocpkgs.nightly-2026-09-19-d025939",
    "rsync",
    "sqlite",
    "unzip"
  ]
  overlays: ["github:roc-lang/roc-overlay"]
}

# kai run generate -- <work> <config.json> <passage-count|all>
# e.g. kai run generate -- 1peter scripts/generate/works/1peter.json 25
# Glosses sentences and translates canonical passages (verses, sections; see
# scripts/Passages.roc) into conllu/generated/<work>-<model>/, resuming its
# checkpoints; missing work makes paid API calls. Meditations Book 1 is 42.
# SIGINT is ignored so Ctrl-C stops the current stage and the loop reports;
# see ../roc-issues/improvements/IMPROVEMENT-002-basic-cli-sigint-handling.
task generate {
  environment: "dev"
  run: ["env", "--ignore-signal=INT", "roc", "scripts/generate/loop.roc"]
}

# Export SQL by default. Configs: scripts/lyceum-{import,replace}.example.json. The databases are
# LYCEUM_WEBSITE_DIR/data/{texts,editions}.db (see .env.example).
# LYCEUM_IMPORT_CONFIG selects the config; LYCEUM_IMPORT_APPLY=1 writes.
# Backups default on; LYCEUM_IMPORT_BACKUP=0 explicitly skips them.
task import-lyceum {
  environment: "dev"
  run: ["roc", "scripts/import-lyceum.roc"]
}

# Stage, verify, back up, and replace only the reader's two content databases.
task deploy-lyceum-data {
  environment: "dev"
  run: ["roc", "scripts/deploy-lyceum-data.roc", "staging"]
}

# Requires LYCEUM_DEPLOY_PRODUCTION=1; never rebuilds the shared host.
task deploy-lyceum-data-prod {
  environment: "dev"
  run: ["roc", "scripts/deploy-lyceum-data.roc", "production"]
}

task check-lyceum-data-deploy {
  environment: "dev"
  run: ["roc", "check", "scripts/deploy-lyceum-data.roc"]
}

task format-lyceum-data-deploy {
  environment: "dev"
  run: ["roc", "fmt", "scripts/deploy-lyceum-data.roc"]
}

task format-lyceum-import {
  environment: "dev"
  run: ["roc", "fmt", "scripts/import-lyceum.roc", "scripts/LyceumConllu.roc", "scripts/LyceumImportSql.roc", "scripts/LyceumWebsite.roc", "scripts/lyceum-website.roc"]
}

task check-lyceum-import {
  environment: "dev"
  run: ["roc", "check", "scripts/import-lyceum.roc"]
}

task check-lyceum-website-tool {
  environment: "dev"
  run: ["roc", "check", "scripts/lyceum-website.roc"]
}

# Lyceum is a separate Go reader; scripts/lyceum-website.roc runs these in its pinned development
# environment, at LYCEUM_WEBSITE_DIR (see .env.example), substituting {website} in each command.
task check-lyceum-reader {
  environment: "dev"
  run: ["roc", "scripts/lyceum-website.roc", "go", "-C", "{website}", "test", "./cmd/...", "./internal/..."]
}

task audit-lyceum-reader {
  environment: "dev"
  run: ["roc", "scripts/lyceum-website.roc", "go", "-C", "{website}", "test", "-tags", "slow", "./cmd/server", "-run", "TestFeaturedInterlinearAudit|TestAesopPerry1", "-v"]
}

task format-lyceum-reader {
  environment: "dev"
  run: ["roc", "scripts/lyceum-website.roc", "gofmt", "-w", "{website}/internal/models/word.go", "{website}/internal/db/texts.go", "{website}/internal/db/sentences.go", "{website}/cmd/server/main.go", "{website}/cmd/server/interlinear_audit_test.go"]
}

task refresh-lyceum-reader-support {
  environment: "dev"
  run: ["roc", "scripts/lyceum-website.roc", "go", "-C", "{website}", "run", "./scripts/generate_reader_support_matrix"]
}

task serve-lyceum-reader {
  environment: "dev"
  run: ["roc", "scripts/lyceum-website.roc", "go", "-C", "{website}", "run", "./cmd/server"]
}

task build-lyceum-reader {
  environment: "dev"
  run: ["roc", "scripts/lyceum-website.roc", "go", "-C", "{website}", "build", "-o", ".tmp/sentence-reader", "./cmd/server"]
}

task check-lyceum-reader-browser {
  environment: "dev"
  run: ["roc", "scripts/lyceum-website.roc", "env", "TEST_LOCAL=1", "npm", "--prefix", "{website}", "test", "--", "--workers=2", "--reporter=line", "--retries=0"]
}

task refresh-lyceum-reader-screenshots {
  environment: "dev"
  run: ["roc", "scripts/lyceum-website.roc", "env", "TEST_LOCAL=1", "npm", "--prefix", "{website}", "test", "--", "screenshots.spec.ts", "--update-snapshots", "--workers=2", "--reporter=line", "--retries=0"]
}

# Reader-only override and rollback; no NixOS switch or changes to other services.
task deploy-lyceum-reader-staging {
  environment: "dev"
  run: ["roc", "scripts/deploy-lyceum-reader.roc", "staging"]
}

task check-lyceum-reader-deploy {
  environment: "dev"
  run: ["roc", "check", "scripts/deploy-lyceum-reader.roc"]
}

task format-lyceum-reader-deploy {
  environment: "dev"
  run: ["roc", "fmt", "scripts/deploy-lyceum-reader.roc"]
}

task check-loop {
  environment: "dev"
  run: [
    "roc",
    "check",
    "scripts/generate/loop.roc"
  ]
}

task check-translate {
  environment: "dev"
  run: [
    "roc",
    "check",
    "scripts/generate/translate.roc"
  ]
}

task check-gloss {
  environment: "dev"
  run: [
    "roc",
    "check",
    "scripts/generate/gloss.roc"
  ]
}

task lint {
  environment: "dev"
  run: ["roc", "scripts/lint.roc"]
}

task check-lint-tool {
  environment: "dev"
  run: ["roc", "check", "scripts/lint.roc"]
}

# kai run vendor-oga-refs -- <opera_graeca_adnotata_v0.2.0.zip> <cts-id>...
# Vendors OGA's canonical citation layer into data/oga/refs/<cts-id>.tsv, which
# scripts/Passages.roc uses to group each work into verses or sections.
task vendor-oga-refs {
  environment: "dev"
  run: ["roc", "devtools/vendor-oga-refs.roc"]
}

task check-passages-tool {
  environment: "dev"
  run: ["roc", "check", "scripts/passages.roc"]
}

# Embeds tests/fixtures/fsrs/*.json in the generated tests/FsrsFixtures.elm.
task generate-fsrs-fixtures {
  environment: "dev"
  run: ["roc", "devtools/generate-fsrs-fixtures.roc"]
}

task check-fsrs-fixtures-tool {
  environment: "dev"
  run: ["roc", "check", "devtools/generate-fsrs-fixtures.roc"]
}

# Runs the Elm tests (the FSRS port against ts-fsrs and fsrs-rs fixtures).
task test-elm {
  environment: "dev"
  run: ["elm-test"]
}

workflow test-fsrs {
  steps: [
    "run generate-fsrs-fixtures",
    "run test-elm"
  ]
}

# Bundles every conllu/generated/<work>-<model>/ folder with output.conllu and
# config.json as corpus <work>, including partially generated works.
task preload {
  environment: "dev"
  run: ["roc", "scripts/build-corpus-preload.roc", "preload", "conllu/generated"]
}

task check-preload-tool {
  environment: "dev"
  run: ["roc", "check", "scripts/build-corpus-preload.roc"]
}

# kai run cite -- <oga-input.conllu> <model>
# Prints the citation preload derives from data/oga/urn_cts.xml; fails if it would be incomplete.
task cite {
  environment: "dev"
  run: ["roc", "scripts/cite.roc"]
}

task check-cite-tool {
  environment: "dev"
  run: ["roc", "check", "scripts/cite.roc"]
}

task check-release-tool {
  environment: "dev"
  run: ["roc", "check", "scripts/build-release.roc"]
}

task check-browser-boundary-tool {
  environment: "dev"
  run: ["roc", "check", "scripts/check-browser-boundary.roc"]
}

task check-deploy-tool {
  environment: "dev"
  run: ["roc", "check", "scripts/deploy.roc"]
}

task check-browser-boundary {
  environment: "dev"
  run: ["roc", "scripts/check-browser-boundary.roc"]
}

task bundle {
  environment: "dev"
  run: ["roc", "scripts/build-release.roc"]
}

task provision {
  environment: "dev"
  run: ["roc", "scripts/deploy.roc", "infrastructure"]
}

workflow release {
  steps: [
    "run check-preload-tool",
    "run check-cite-tool",
    "run check-release-tool",
    "run check-browser-boundary-tool",
    "run check-deploy-tool",
    "run check-lint-tool",
    "run preload",
    "run check-browser-boundary",
    "run bundle"
  ]
}

environment dev {
  packages: [
    "bashInteractive",
    "coreutils",
    "curl",
    "elmPackages.elm",
    "elmPackages.elm-live",
    "git",
    "gnugrep",
    "openssh",
    "rocpkgs.nightly",
    "rsync"
  ]
  overlays: ["github:roc-lang/roc-overlay"]
}

task prepare-genesis-sample {
  environment: "dev"
  run: [
    "roc",
    "experiments/oga-conllu/oga-deepseek-v4-flash-0731-exp2/src/prepare-genesis-sample.roc",
    "../conllu/PTNK/not-to-release/ready/genesis.conllu",
    "experiments/oga-conllu/oga-deepseek-v4-flash-0731-exp2/inputs/genesis-01.1-20.no-gloss.conllu"
  ]
}

# These experiment tasks make paid API calls.
task translate {
  environment: "dev"
  run: [
    "roc",
    "experiments/oga-conllu/oga-deepseek-v4-flash-0731-exp2/src/translate.roc",
    "experiments/oga-conllu/oga-deepseek-v4-flash-0731-exp2/inputs/genesis-01.1-20.no-gloss.conllu"
  ]
}

task gloss {
  environment: "dev"
  run: [
    "roc",
    "experiments/oga-conllu/oga-deepseek-v4-flash-0731-exp2/src/gloss.roc",
    "experiments/oga-conllu/oga-deepseek-v4-flash-0731-exp2/outputs/output.conllu"
  ]
}

task audit {
  environment: "dev"
  run: [
    "roc",
    "experiments/oga-conllu/oga-deepseek-v4-flash-0731-exp2/src/audit.roc",
    "experiments/oga-conllu/oga-deepseek-v4-flash-0731-exp2/outputs/gloss-output.conllu"
  ]
}

task improve {
  environment: "dev"
  run: [
    "roc",
    "experiments/oga-conllu/oga-deepseek-v4-flash-0731-exp2/src/improve.roc",
    "experiments/oga-conllu/oga-deepseek-v4-flash-0731-exp2/outputs/gloss-output.conllu",
    "experiments/oga-conllu/oga-deepseek-v4-flash-0731-exp2/outputs/audit.json"
  ]
}

task conllu-loop {
  environment: "dev"
  run: [
    "roc",
    "experiments/oga-conllu/oga-deepseek-v4-flash-0731-exp2/src/loop.roc",
    "experiments/oga-conllu/oga-deepseek-v4-flash-0731-exp2/inputs/genesis-01.1-20.no-gloss.conllu",
    "translate,gloss,audit"
  ]
}

task check-loop {
  environment: "dev"
  run: [
    "roc",
    "check",
    "experiments/oga-conllu/oga-deepseek-v4-flash-0731-exp2/src/loop.roc"
  ]
}

task check-translate {
  environment: "dev"
  run: [
    "roc",
    "check",
    "experiments/oga-conllu/oga-deepseek-v4-flash-0731-exp2/src/translate.roc"
  ]
}

task check-gloss {
  environment: "dev"
  run: [
    "roc",
    "check",
    "experiments/oga-conllu/oga-deepseek-v4-flash-0731-exp2/src/gloss.roc"
  ]
}

task check-audit {
  environment: "dev"
  run: [
    "roc",
    "check",
    "experiments/oga-conllu/oga-deepseek-v4-flash-0731-exp2/src/audit.roc"
  ]
}

task check-improve {
  environment: "dev"
  run: [
    "roc",
    "check",
    "experiments/oga-conllu/oga-deepseek-v4-flash-0731-exp2/src/improve.roc"
  ]
}

task lint {
  environment: "dev"
  run: ["roc", "scripts/lint.roc"]
}

task check-lint-tool {
  environment: "dev"
  run: ["roc", "check", "scripts/lint.roc"]
}

task preload {
  environment: "dev"
  run: [
    "roc",
    "scripts/build-corpus-preload.roc",
    "preload",
    "anabasis",
    "conllu/xenophon/anabasis/book-01-first-sentence.tb.conllu"
  ]
}

task check-preload-tool {
  environment: "dev"
  run: ["roc", "check", "scripts/build-corpus-preload.roc"]
}

task check-release-tool {
  environment: "dev"
  run: ["roc", "check", "scripts/build-release.roc"]
}

task check-browser-boundary-tool {
  environment: "dev"
  run: ["roc", "check", "scripts/check-browser-boundary.roc"]
}

task check-deploy-tool {
  environment: "dev"
  run: ["roc", "check", "scripts/deploy.roc"]
}

task check-browser-boundary {
  environment: "dev"
  run: ["roc", "scripts/check-browser-boundary.roc"]
}

task bundle {
  environment: "dev"
  run: ["roc", "scripts/build-release.roc"]
}

task publish {
  environment: "dev"
  run: ["roc", "scripts/deploy.roc"]
}

task provision {
  environment: "dev"
  run: ["roc", "scripts/deploy.roc", "infrastructure"]
}

workflow conllu {
  steps: [
    "run prepare-genesis-sample",
    "run conllu-loop"
  ]
}

workflow release {
  steps: [
    "run check-preload-tool",
    "run check-release-tool",
    "run check-browser-boundary-tool",
    "run check-deploy-tool",
    "run check-lint-tool",
    "run preload",
    "run check-browser-boundary",
    "run bundle"
  ]
}

workflow deploy {
  steps: [
    "run preload",
    "run check-browser-boundary",
    "run bundle",
    "run publish"
  ]
}

environment dev {
  packages: [
    "bashInteractive",
    "coreutils",
    "curl",
    "elmPackages.elm",
    "elmPackages.elm-live",
    "git",
    "gnugrep",
    "openssh",
    "roc",
    "rsync"
  ]
}

task preload {
  environment: "dev"
  run: [
    "roc",
    "scripts/build-corpus-preload.roc",
    "preload",
    "anabasis",
    "conllu/xenophon/anabasis/book-01-first-sentence.tb.conllu"
  ]
}

task lint {
  environment: "dev"
  run: ["roc", "scripts/lint.roc"]
}

task check-browser-boundary {
  environment: "dev"
  run: ["roc", "scripts/check-browser-boundary.roc"]
}

task build {
  environment: "dev"
  run: ["elm", "make", "src/Main.elm", "--output=elm.js"]
}

task serve {
  environment: "dev"
  run: [
    "elm-live",
    "src/Main.elm",
    "--dir=.",
    "--host=localhost",
    "--port=8000",
    "--hot",
    "--",
    "--output=elm.js"
  ]
}

task bundle {
  environment: "dev"
  run: ["roc", "scripts/build-release.roc"]
}

task publish {
  environment: "dev"
  run: ["roc", "scripts/deploy.roc"]
}

task provision {
  environment: "dev"
  run: ["roc", "scripts/deploy.roc", "infrastructure"]
}

workflow dev {
  steps: [
    "run preload",
    "run check-browser-boundary",
    "run build",
    "run serve"
  ]
}

workflow release {
  steps: [
    "run preload",
    "run check-browser-boundary",
    "run bundle"
  ]
}

workflow deploy {
  steps: [
    "run preload",
    "run check-browser-boundary",
    "run bundle",
    "run publish"
  ]
}

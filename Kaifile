environment dev {
  packages: [
    "bashInteractive",
    "coreutils",
    "curl",
    "elmPackages.elm",
    "elmPackages.elm-live",
    "gnugrep",
    "openssh",
    "roc",
    "rsync"
  ]
}

task import-anabasis {
  environment: "dev"
  run: ["roc", "scripts/import-lyceum-anabasis.roc"]
}

task build {
  environment: "dev"
  run: ["elm", "make", "src/Main.elm", "--output=elm.js"]
}

task serve {
  environment: "dev"
  run: [
    "elm-live",
    "src/Main.elm",
    "--dir=.",
    "--host=localhost",
    "--port=8000",
    "--hot",
    "--",
    "--output=elm.js"
  ]
}

task release {
  environment: "dev"
  run: ["./scripts/build-release.sh"]
}

task deploy {
  environment: "dev"
  run: ["./scripts/deploy.sh"]
}

workflow dev {
  steps: [
    "run import-anabasis",
    "run build",
    "run serve"
  ]
}

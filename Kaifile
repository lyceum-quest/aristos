environment dev {
  packages: [
    "bashInteractive",
    "coreutils",
    "curl",
    "elmPackages.elm",
    "elmPackages.elm-live",
    "git",
    "gnugrep",
    "openssh",
    "rocpkgs.nightly-2026-09-19-d025939",
    "rsync",
    "sqlite"
  ]
  overlays: ["github:roc-lang/roc-overlay"]
}

# Sonnet-only generation; missing sentences make paid PPQ calls.
# Book 1 is the first 119 blocks, including the closing location note.
# Resume completed sentences; Book 2 begins at source token t_2123.
task meditations-loop {
  environment: "dev"
  run: [
    "roc",
    "experiments/oga-conllu/oga-deepseek-v4-flash-0731-exp2/src/loop.roc",
    "experiments/oga-conllu/oga-deepseek-v4-flash-0731-exp2/inputs/meditations/tlg0562.tlg001.perseus-grc2.tok01_sentence-seg01_annotated_lemma.conllu",
    "119"
  ]
}

# Export SQL by default. Configs: scripts/lyceum-{import,replace}.example.json.
# LYCEUM_IMPORT_CONFIG selects the config; LYCEUM_IMPORT_APPLY=1 writes.
# Backups default on; LYCEUM_IMPORT_BACKUP=0 explicitly skips them.
task import-lyceum {
  environment: "dev"
  run: ["roc", "scripts/import-lyceum.roc"]
}

# Stage, verify, back up, and replace only the reader's two content databases.
task deploy-lyceum-data {
  environment: "dev"
  run: ["roc", "scripts/deploy-lyceum-data.roc", "staging"]
}

# Requires LYCEUM_DEPLOY_PRODUCTION=1; never rebuilds the shared host.
task deploy-lyceum-data-prod {
  environment: "dev"
  run: ["roc", "scripts/deploy-lyceum-data.roc", "production"]
}

task check-lyceum-data-deploy {
  environment: "dev"
  run: ["roc", "check", "scripts/deploy-lyceum-data.roc"]
}

task format-lyceum-data-deploy {
  environment: "dev"
  run: ["roc", "fmt", "scripts/deploy-lyceum-data.roc"]
}

task format-lyceum-import {
  environment: "dev"
  run: ["roc", "fmt", "scripts/import-lyceum.roc", "scripts/LyceumConllu.roc", "scripts/LyceumImportSql.roc"]
}

task check-lyceum-import {
  environment: "dev"
  run: ["roc", "check", "scripts/import-lyceum.roc"]
}

task check-loop {
  environment: "dev"
  run: [
    "roc",
    "check",
    "experiments/oga-conllu/oga-deepseek-v4-flash-0731-exp2/src/loop.roc"
  ]
}

task check-translate {
  environment: "dev"
  run: [
    "roc",
    "check",
    "experiments/oga-conllu/oga-deepseek-v4-flash-0731-exp2/src/translate.roc"
  ]
}

task check-gloss {
  environment: "dev"
  run: [
    "roc",
    "check",
    "experiments/oga-conllu/oga-deepseek-v4-flash-0731-exp2/src/gloss.roc"
  ]
}

task lint {
  environment: "dev"
  run: ["roc", "scripts/lint.roc"]
}

task check-lint-tool {
  environment: "dev"
  run: ["roc", "check", "scripts/lint.roc"]
}

task preload {
  environment: "dev"
  run: [
    "roc",
    "scripts/build-corpus-preload.roc",
    "preload",
    "anabasis",
    "conllu/xenophon/anabasis/book-01-first-sentence.tb.conllu"
  ]
}

task check-preload-tool {
  environment: "dev"
  run: ["roc", "check", "scripts/build-corpus-preload.roc"]
}

task check-release-tool {
  environment: "dev"
  run: ["roc", "check", "scripts/build-release.roc"]
}

task check-browser-boundary-tool {
  environment: "dev"
  run: ["roc", "check", "scripts/check-browser-boundary.roc"]
}

task check-deploy-tool {
  environment: "dev"
  run: ["roc", "check", "scripts/deploy.roc"]
}

task check-browser-boundary {
  environment: "dev"
  run: ["roc", "scripts/check-browser-boundary.roc"]
}

task bundle {
  environment: "dev"
  run: ["roc", "scripts/build-release.roc"]
}

task publish {
  environment: "dev"
  run: ["roc", "scripts/deploy.roc"]
}

task provision {
  environment: "dev"
  run: ["roc", "scripts/deploy.roc", "infrastructure"]
}

workflow meditations {
  steps: ["run meditations-loop"]
}

workflow release {
  steps: [
    "run check-preload-tool",
    "run check-release-tool",
    "run check-browser-boundary-tool",
    "run check-deploy-tool",
    "run check-lint-tool",
    "run preload",
    "run check-browser-boundary",
    "run bundle"
  ]
}

workflow deploy {
  steps: [
    "run preload",
    "run check-browser-boundary",
    "run bundle",
    "run publish"
  ]
}

# Copy to .env (git-ignored) in the repository root. A variable set in the environment overrides .env.

# The Lyceum website checkout (the Go reader and its data/texts.db and data/editions.db), absolute or
# relative to this repository. Required by import-lyceum, the deploy-lyceum-* tasks, provision, and every
# *-lyceum-reader task; there is no default.
LYCEUM_WEBSITE_DIR=../website-private

# Deploy targets (deploy-lyceum-data, deploy-lyceum-reader-staging, provision): an SSH destination, which may
# include a user (the deploys need root), and the reader URL checked at <url>/health after a deploy.
# Staging is reached over the tailnet, so its URL defaults to http://<host> rather than a public domain.
# LYCEUM_STAGING_HOST=lyceum-staging
# LYCEUM_STAGING_URL=http://lyceum-staging
# LYCEUM_PROD_HOST=lyceum-prod
# LYCEUM_PROD_URL=https://lyceum.quest

# Per-run switches, read only from the environment, never from .env, so a write or a production deploy
# is always a deliberate command:
#   LYCEUM_IMPORT_CONFIG=scripts/lyceum-imports/<work>.json  import-lyceum config (required)
#   LYCEUM_IMPORT_APPLY=1        apply the SQL to the website's databases (default 0: write SQL only)
#   LYCEUM_IMPORT_BACKUP=0       skip the backups taken before applying (default 1)
#   LYCEUM_DEPLOY_PRODUCTION=1   required by deploy-lyceum-data-prod

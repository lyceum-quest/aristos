# Kai-generated environment; only the lock is committed
/.kai/*
!/.kai/lock.json

# Local settings (see .env.example)
.env

# Elm build cache and generated browser bundle
elm-stuff/
elm.js
dist/
preload/

# Elm REPL scratch files
repl-temp-*

# Roc script executables
/scripts/build-release
/scripts/check-browser-boundary
/scripts/deploy-site
/scripts/fetch-preload

# Left by an interrupted fetch-preload
/preload.fetch-*/

# Local planning and research documents (directories and all contents)
/plans/
/docs/plans/
/docs/static/plan.md

# Local editor and OS files
.DS_Store
*~

# Generated Elm test fixtures (devtools/generate-fsrs-fixtures.roc)
/tests/FsrsFixtures.elm
